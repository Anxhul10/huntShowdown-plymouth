for (i = 1; i <= 173; i++) {

  if (i < 10)
    filename = "/media/1920x1080/ezgif-frame-00" + i + ".png";
  else if (i < 100)
    filename = "/media/1920x1080/ezgif-frame-0" + i + ".png";
  else
    filename = "/media/1920x1080/ezgif-frame-" + i + ".png";
  
  hunt_show_down_arr[i] = Image(filename);
}

pos_x = Window.GetWidth()/2 - hunt_show_down_arr[1].GetWidth()/2;
pos_y = Window.GetHeight()/2 - hunt_show_down_arr[1].GetHeight()/2;

sprite = Sprite(hunt_show_down_arr[1]);
sprite.SetX(pos_x);
sprite.SetY(pos_y);

count = 1;

# The animation is meant to play *after* a disk-unlock/question prompt (if any)
# has been answered, so it must not start the instant the splash appears: on
# encrypted systems the prompt only arrives a beat later, and animating in that
# window flashes frames before the prompt replaces them.
#
# So start hidden. If a prompt turns up, the animation waits for the unlock. If
# none has turned up by the time the grace period expires, there is nothing to
# unlock on this system and the animation just plays from there.
animating = 0;
had_prompt = 0;
startup_ticks = 0;

# Plymouth drives the refresh callback at ~50Hz, so this is roughly 1.5s.
# Raise it if a slower initramfs still flashes frames before the prompt appears.
startup_grace_ticks = 75;

sprite.SetOpacity(0);

fun start_animation () {
  animating = 1;
  sprite.SetOpacity(1);
}

fun refresh_callback () {

  if (animating) {
    sprite.SetImage(hunt_show_down_arr[count]);

    sprite.SetScale(scale);

    count += 1;
  } else if (had_prompt == 0) {
    # No prompt yet - run out the grace period, then assume there won't be one.
    startup_ticks += 1;

    if (startup_ticks >= startup_grace_ticks)
      start_animation();
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

#----------------------------------------- Disk unlock prompt --------------------------------

prompt_label_image = Image.Text(" ", 1, 1, 1);
prompt_label_sprite = Sprite(prompt_label_image);
prompt_label_sprite.SetZ(10000);
prompt_label_sprite.SetOpacity(0);

prompt_entry_image = Image.Text(" ", 1, 1, 1);
prompt_entry_sprite = Sprite(prompt_entry_image);
prompt_entry_sprite.SetZ(10000);
prompt_entry_sprite.SetOpacity(0);

fun set_prompt_label (text) {
  prompt_label_image = Image.Text(text, 1, 1, 1);
  prompt_label_sprite.SetImage(prompt_label_image);
  prompt_label_sprite.SetX(Window.GetWidth()/2 - prompt_label_image.GetWidth()/2);
  prompt_label_sprite.SetY(Window.GetHeight()/2 - prompt_label_image.GetHeight() - 5);
  prompt_label_sprite.SetOpacity(1);
}

fun set_prompt_entry (text) {
  prompt_entry_image = Image.Text(text, 1, 1, 1);
  prompt_entry_sprite.SetImage(prompt_entry_image);
  prompt_entry_sprite.SetX(Window.GetWidth()/2 - prompt_entry_image.GetWidth()/2);
  prompt_entry_sprite.SetY(Window.GetHeight()/2 + 5);
  prompt_entry_sprite.SetOpacity(1);
}

fun hide_prompt () {
  prompt_label_sprite.SetOpacity(0);
  prompt_entry_sprite.SetOpacity(0);
}

fun display_normal_callback () {
  hide_prompt();

  # Coming back from a prompt means the passphrase/answer was accepted -
  # that's the cue to (re)start the animation from the first frame.
  if (had_prompt) {
    count = 1;
    start_animation();
  }
}

fun display_password_callback (prompt, bullets) {

  if (animating) {
    animating = 0;
    count = 1;
  }
  sprite.SetOpacity(0);
  had_prompt = 1;

  if (prompt == "")
    prompt = "Enter passphrase to unlock disk:";

  set_prompt_label(prompt);

  bullet_string = "";
  for (i = 0; i < bullets; i++)
    bullet_string += "*";
  if (bullet_string == "")
    bullet_string = " ";

  set_prompt_entry(bullet_string);
}

fun display_question_callback (prompt, entry) {

  if (animating) {
    animating = 0;
    count = 1;
  }
  sprite.SetOpacity(0);
  had_prompt = 1;

  if (entry == "")
    entry = " ";

  set_prompt_label(prompt);
  set_prompt_entry(entry);
}

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
